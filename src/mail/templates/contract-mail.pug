doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Service Agreement – Bambini Doula
  body(style="font-family: Arial, sans-serif; background-color: #f7f7f7; padding: 20px;")
    table(width="100%" cellpadding="0" cellspacing="0")
      tr
        td(align="center")
          table(width="600" cellpadding="0" cellspacing="0" style="background: #ffffff; padding: 24px; border-radius: 8px;")
            tr
              td
                h2(style="color: #333;") Hello #{clientName},
                p(style="color: #555; font-size: 14px; line-height: 1.6;")
                  | Welcome to 
                  strong Bambini Doula
                  | .
                p(style="color: #555; font-size: 14px; line-height: 1.6;")
                  | Thank you for completing your registration. Please find your
                  strong  Service Agreement
                  |  attached to this email.
                p(style="color: #555; font-size: 14px; line-height: 1.6;")
                  | We recommend keeping a copy for your records.
                br
                p(style="color: #777; font-size: 13px;")
                  | If you have any questions, feel free to reply to this email.
                br
                p(style="color: #333; font-size: 14px;")
                  | Regards,
                  br
                  strong Bambini Doula Team
                hr(style="margin-top: 30px;")
                p(style="color: #999; font-size: 12px; text-align: center;")
                  | © #{year} Bambini Doula. All rights reserved.
