doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title OTP Verification
    style.
      body {
        margin: 0;
        padding: 0;
        background: linear-gradient(180deg, #EAF2FB, #FFFFFF);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Inter, Helvetica, Arial, sans-serif;
        color: #0F172A;
      }

      table {
        border-collapse: collapse;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .card {
        max-width: 520px;
        margin: 0 auto;
        background: #FFFFFF;
        border-radius: 14px;
        padding: 32px 28px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }

      .logo {
        text-align: center;
        font-size: 20px;
        font-weight: 600;
        color: #0F172A;
        margin-bottom: 24px;
      }

      .title {
        font-size: 22px;
        font-weight: 600;
        text-align: center;
        margin-bottom: 12px;
      }

      .subtitle {
        font-size: 14px;
        color: #64748B;
        text-align: center;
        margin-bottom: 28px;
        line-height: 1.6;
      }

      .otp-box {
        background: #EAF2FB;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        margin-bottom: 24px;
      }

      .otp {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 6px;
        color: #3B6EF5;
      }

      .info {
        font-size: 14px;
        color: #334155;
        line-height: 1.6;
        margin-bottom: 18px;
        text-align: center;
      }

      .warning {
        font-size: 13px;
        color: #64748B;
        text-align: center;
        line-height: 1.6;
      }

      .footer {
        margin-top: 32px;
        font-size: 12px;
        color: #94A3B8;
        text-align: center;
      }

  body
    table.wrapper(width="100%" role="presentation")
      tr
        td(align="center")
          .card
            .logo #{appName}

            .title Verify Your Email

            .subtitle
              | Please use the OTP below to complete your verification.
              br
              | This helps us keep your account secure.

            .otp-box
              .otp #{otp}

            .info
              | This OTP is valid for 
              strong #{expiryMinutes} minutes
              | . Do not share this code with anyone.

            .warning
              | If you did not request this verification, you can safely ignore this email.

            .footer
              | © #{year} #{appName}. All rights reserved.
