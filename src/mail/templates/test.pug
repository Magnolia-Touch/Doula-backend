doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="x-apple-disable-message-reformatting")
    title Bambini Doulas
    //- Google Fonts for that elegant touch (Fallbacks included in inline styles)
    style.
      @import url('https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&family=Lato:wght@400;700&display=swap');
      /* Client-specific resets */
      body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
      
  body(style="margin:0; padding:0; background-color:#F5F5F0; font-family: 'Lato', Helvetica, Arial, sans-serif;")

    //- INVISIBLE PREHEADER
    div(style="display:none; max-height:0; overflow:hidden;")
      | Congratulations on your journey! Professional, nurturing support for pregnancy, birth, and postpartum.

    //- MAIN WRAPPER
    table(width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F5F0; padding: 40px 10px;")
      tr
        td(align="center")

          //- CONTENT CONTAINER
          table(width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);")

            //- HERO IMAGE
            tr
              td(align="center" style="background-color:#ffffff;")
                a(href="#" style="text-decoration:none; display:block;")
                  img(
                    src="https://dev-palqar-bucket.s3.ap-south-1.amazonaws.com/uploads/manager/profile/1770092194343-m6ivpj7hcd.jpeg"
                    alt="Mother gently holding newborn"
                    width="600"
                    style="display:block; width:100%; height:auto; border:0;"
                  )

            //- WELCOME SECTION
            tr
              td(style="padding: 40px 40px 20px 40px; text-align:center;")
                h1(style="margin:0 0 16px; font-family: 'Merriweather', Georgia, serif; font-size:26px; font-weight:400; color:#2C3E38;")
                  | Welcome to the Family
                p(style="margin:0 0 24px; font-size:16px; line-height:1.7; color:#555555;")
                  | Congratulations on this exciting journey! At 
                  strong(style="color:#4A6B65;") Bambini Doulas
                  | , we provide personalized, nurturing support throughout pregnancy, birth, and postpartum. We are here to ensure you never feel alone.

            //- PRIMARY CTA
            tr
              td(align="center" style="padding-bottom: 40px;")
                table(cellpadding="0" cellspacing="0" border="0")
                  tr
                    td(align="center" style="background-color:#4A6B65; border-radius: 50px;")
                      a(
                        href="#"
                        style="display:block; padding: 14px 32px; font-family:'Lato', sans-serif; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none; text-transform:uppercase; letter-spacing:0.5px;"
                      ) Schedule Free Consultation

            //- WHY CHOOSE US (Styled as a soft card)
            tr
              td(style="padding: 0 40px 40px 40px;")
                table(width="100%" cellpadding="0" cellspacing="0" style="background-color:#F2F6F5; border-radius:12px; padding:30px;")
                  tr
                    td(align="center" style="padding-bottom:20px;")
                      h2(style="margin:0; font-family: 'Merriweather', Georgia, serif; font-size:20px; color:#2C3E38;")
                        | Why Choose Us?
                      p(style="margin:5px 0 0; font-size:14px; color:#6B8E87; text-transform:uppercase; letter-spacing:1px;")
                        | Birth & Postpartum Care Made Simple
                  
                  //- Feature Grid
                  tr
                    td
                      table(width="100%" cellpadding="0" cellspacing="0")
                        tr
                          td(width="50%" style="padding:8px 0; vertical-align:top;")
                            table(cellpadding="0" cellspacing="0")
                              tr
                                td(style="color:#4A6B65; font-size:18px; line-height:1; padding-right:8px;") •
                                td(style="font-size:15px; color:#444;") HSA / FSA Accepted
                          td(width="50%" style="padding:8px 0; vertical-align:top;")
                            table(cellpadding="0" cellspacing="0")
                              tr
                                td(style="color:#4A6B65; font-size:18px; line-height:1; padding-right:8px;") •
                                td(style="font-size:15px; color:#444;") Insurance Reimbursement
                        tr
                          td(width="50%" style="padding:8px 0; vertical-align:top;")
                            table(cellpadding="0" cellspacing="0")
                              tr
                                td(style="color:#4A6B65; font-size:18px; line-height:1; padding-right:8px;") •
                                td(style="font-size:15px; color:#444;") Carrot & Progyny
                          td(width="50%" style="padding:8px 0; vertical-align:top;")
                            table(cellpadding="0" cellspacing="0")
                              tr
                                td(style="color:#4A6B65; font-size:18px; line-height:1; padding-right:8px;") •
                                td(style="font-size:15px; color:#444;") Flexible Payment Plans

            //- QUOTE / VALUE
            tr
              td(align="center" style="padding: 0 40px 30px 40px;")
                p(style="font-family: 'Merriweather', Georgia, serif; font-style:italic; font-size:18px; color:#555; line-height:1.6; margin:0;")
                  | "Because every family deserves reliable and compassionate doula support."
                p(style="margin-top:10px; font-size:14px; color:#999;")
                  | — @bambinidoulas

            //- SECONDARY BUTTONS (Stacked for elegance)
            tr
              td(align="center" style="padding: 0 40px 40px 40px;")
                //- Button 1: Outline
                a(
                  href="#"
                  style="display:inline-block; border:1px solid #4A6B65; border-radius:50px; padding:12px 30px; font-size:15px; color:#4A6B65; text-decoration:none; font-weight:700; margin-bottom:15px;"
                ) View Service Packages
                
                br

                //- EXCLUSIVE OFFER BOX
                table(width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px; border-top:1px dashed #cccccc; border-bottom:1px dashed #cccccc;")
                  tr
                    td(align="center" style="padding:20px 0;")
                      p(style="margin:0; font-size:14px; color:#C07858; font-weight:700; text-transform:uppercase; letter-spacing:1px;") Limited Time Gift
                      p(style="margin:5px 0 0; font-size:16px; color:#333;")
                        | Secure your doula today and enjoy 
                        strong 5% OFF
                        |  our services.

            //- FOOTER INFO
            tr
              td(style="background-color:#F9F9F9; padding:30px; border-top:1px solid #eeeeee;")
                table(width="100%" cellpadding="0" cellspacing="0")
                  tr
                    td(align="center" style="padding-bottom:20px;")
                      //- Social Links
                      a(href="#" style="color:#4A6B65; text-decoration:none; font-weight:bold; margin:0 10px; font-size:14px;") Instagram
                      a(href="#" style="color:#4A6B65; text-decoration:none; font-weight:bold; margin:0 10px; font-size:14px;") Facebook
                  
                  tr
                    td(align="center" style="font-size:12px; color:#888888; line-height:1.5;")
                      p(style="margin:0 0 10px;")
                        strong BAMBINI DOULAS LLC
                        br
                        | 1201 Liberty St, #9, El Cerrito, CA 94530
                      
                      p(style="margin:0 0 10px; font-family: monospace; color:#999;")
                        | EIN: 81-1222318 | NPI: 1508586942 | Taxonomy: 374J00000X
                      
                      p(style="margin:15px 0 0;")
                        a(href="#" style="color:#aaaaaa; text-decoration:underline;") Unsubscribe