doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="x-apple-disable-message-reformatting")
    title Booking Confirmation
    style.
      @import url('https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&family=Lato:wght@400;700&display=swap');
      body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
      .label { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
      .value { font-size: 15px; color: #333; font-weight: 400; margin-bottom: 12px; }

  body(style="margin:0; padding:0; background-color:#F5F5F0; font-family: 'Lato', Helvetica, Arial, sans-serif;")

    //- INVISIBLE PREHEADER
    div(style="display:none; max-height:0; overflow:hidden;")
      | Your service booking has been successfully confirmed. View details inside.

    //- MAIN WRAPPER
    table(width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F5F0; padding: 40px 10px;")
      tr
        td(align="center")

          //- CONTENT CONTAINER
          table(width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);")

            //- HERO IMAGE
            tr
              td(align="center" style="background-color:#ffffff;")
                img(
                  src="https://dev-palqar-bucket.s3.ap-south-1.amazonaws.com/uploads/manager/profile/1770092194343-m6ivpj7hcd.jpeg"
                  alt="Booking Confirmed"
                  width="600"
                  style="display:block; width:100%; height:auto; border:0;"
                )

            //- HEADER SECTION
            tr
              td(style="padding: 40px 40px 20px 40px; text-align:center;")
                h1(style="margin:0 0 10px; font-family: 'Merriweather', Georgia, serif; font-size:26px; font-weight:400; color:#2C3E38;")
                  | Booking Successful
                p(style="margin:0; font-size:16px; line-height:1.6; color:#555555;")
                  | Thank you! Your booking has been confirmed. Below are the details of your scheduled service and your assigned Doula.

            //- DETAILS SECTION (Replaces the Offer Section)
            tr
              td(style="padding: 10px 40px 40px 40px;")
                //- Grey Background Container
                table(width="100%" cellpadding="0" cellspacing="0" style="background-color:#F2F6F5; border-radius:12px; padding:30px;")
                  
                  //- SERVICE DETAILS HEADER
                  tr
                    td(style="padding-bottom:15px; border-bottom:1px solid #D8E2E0;")
                      h2(style="margin:0; font-family: 'Merriweather', Georgia, serif; font-size:18px; color:#4A6B65;")
                        | Service Details
                  
                  //- SERVICE DATA GRID
                  tr
                    td(style="padding-top:15px;")
                      table(width="100%" cellpadding="0" cellspacing="0")
                        tr
                          //- Column 1
                          td(width="50%" valign="top")
                            div(class="label") Service Name
                            div(class="value") #{serviceName}
                            
                            div(class="label") Region
                            div(class="value") #{region}

                            div(class="label") Start Date
                            div(class="value") #{serviceStartDate}

                            div(class="label") Amount Paid
                            div(class="value" style="color:#4A6B65; font-weight:bold;") #{AmountPaid}
                          
                          //- Column 2
                          td(width="50%" valign="top")
                            div(class="label") Time Shift
                            div(class="value") #{timeShift}

                            div(class="label") End Date
                            div(class="value") #{serviceEndDate}

                            div(class="label") Total Amount
                            div(class="value") #{totalAmount}

                  //- DOULA DETAILS HEADER
                  tr
                    td(style="padding: 25px 0 15px 0; border-bottom:1px solid #D8E2E0;")
                      h2(style="margin:0; font-family: 'Merriweather', Georgia, serif; font-size:18px; color:#4A6B65;")
                        | Assigned Doula
                  
                  //- DOULA DATA GRID
                  tr
                    td(style="padding-top:15px;")
                      table(width="100%" cellpadding="0" cellspacing="0")
                        tr
                          td(valign="top")
                            div(class="label") Name
                            div(class="value" style="font-size:16px; font-weight:bold;") #{doulaName}
                            
                            div(class="label") Contact Email
                            div(class="value") 
                              a(href="mailto:#{doulaEmail}" style="color:#4A6B65; text-decoration:none;") #{doulaEmail}
                            
                            div(class="label") Phone
                            div(class="value") #{doulaPhone}

            //- FOOTER INFO
            tr
              td(style="background-color:#F9F9F9; padding:30px; border-top:1px solid #eeeeee;")
                table(width="100%" cellpadding="0" cellspacing="0")
                  tr
                    td(align="center" style="font-size:12px; color:#888888; line-height:1.5;")
                      p(style="margin:0 0 10px;")
                        strong BAMBINI DOULAS LLC
                        br
                        | 1201 Liberty St, #9, El Cerrito, CA 94530
                      
                      p(style="margin:0 0 10px; font-family: monospace; color:#999;")
                        | EIN: 81-1222318 | NPI: 1508586942 | Taxonomy: 374J00000X
                      
                      p(style="margin:15px 0 0;")
                        a(href="#" style="color:#aaaaaa; text-decoration:underline;") Contact Support